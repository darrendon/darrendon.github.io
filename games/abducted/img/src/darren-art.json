"signal-back": "<div style=\"position: relative; width: 264px; height: 408px; border-radius: 16px; overflow: hidden; background: #F6B92B; box-shadow: 0 6px 18px rgba(27,27,47,.18)\">\n<div style=\"position: absolute; inset: 10px; border: 2.5px solid #1B1B2F; border-radius: 10px\"></div>\n<svg width=\"200\" height=\"200\" viewBox=\"0 0 200 200\" style=\"position: absolute; left: 32px; top: 64px\" role=\"img\" aria-label=\"Signal card back: a satellite dish pointed at the sky\">\n<path d=\"M128 46 Q146 50 150 68 M134 26 Q166 32 172 64\" stroke=\"#E8553A\" stroke-width=\"6\" fill=\"none\" stroke-linecap=\"round\"></path>\n<path d=\"M88 150 L80 182 H124 L116 150Z\" fill=\"#2E4BD8\" stroke=\"#1B1B2F\" stroke-width=\"5\" stroke-linejoin=\"round\"></path>\n<path d=\"M102 150 V128\" stroke=\"#1B1B2F\" stroke-width=\"6\" stroke-linecap=\"round\"></path>\n<g transform=\"rotate(-35 100 112)\">\n<path d=\"M40 112 A60 34 0 0 0 160 112Z\" fill=\"#FFF4DE\" stroke=\"#1B1B2F\" stroke-width=\"5\" stroke-linejoin=\"round\"></path>\n<path d=\"M100 112 V72\" stroke=\"#1B1B2F\" stroke-width=\"5\" stroke-linecap=\"round\"></path>\n<circle cx=\"100\" cy=\"68\" r=\"8\" fill=\"#E8553A\" stroke=\"#1B1B2F\" stroke-width=\"4\"></circle>\n</g>\n</svg>\n<div style=\"position: absolute; left: 0; right: 0; bottom: 40px; text-align: center; font-family: 'Dela Gothic One', 'Arial Black', sans-serif; font-size: 24px; letter-spacing: .1em; color: #1B1B2F\">SIGNAL</div>\n</div>",
"split": "<div style=\"position: relative; width: 264px; height: 408px; border-radius: 16px; overflow: hidden; background: #1B2350; box-shadow: 0 6px 18px rgba(27,27,47,.18)\">\n<div style=\"position: absolute; left: 0; top: 0; width: 132px; height: 408px; background: #FFF4DE\"></div>\n<div style=\"position: absolute; inset: 10px; border: 2.5px solid #F6B92B; border-radius: 10px\"></div>\n<svg width=\"264\" height=\"408\" viewBox=\"0 0 264 408\" style=\"position: absolute; inset: 0\" aria-hidden=\"true\">\n<path d=\"M132 24 V384\" stroke=\"#F6B92B\" stroke-width=\"5\" stroke-dasharray=\"14 10\" stroke-linecap=\"round\"></path>\n<path d=\"M104 318 H36 M52 302 L36 318 L52 334\" stroke=\"#1B2350\" stroke-width=\"6\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n<path d=\"M160 318 H228 M212 302 L228 318 L212 334\" stroke=\"#FFF4DE\" stroke-width=\"6\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n</svg>\n<div style=\"position: absolute; left: 0; width: 132px; top: 110px; text-align: center; font-size: 14px; font-weight: 800; letter-spacing: .08em; color: #1B2350\">PARTY</div>\n<div style=\"position: absolute; left: 0; width: 132px; top: 134px; text-align: center; font-family: 'Dela Gothic One', 'Arial Black', sans-serif; font-size: 120px; line-height: 1; color: #1B2350\" role=\"img\" aria-label=\"Party 1 side\">1</div>\n<div style=\"position: absolute; left: 132px; width: 132px; top: 110px; text-align: center; font-size: 14px; font-weight: 800; letter-spacing: .08em; color: #FFF4DE\">PARTY</div>\n<div style=\"position: absolute; left: 132px; width: 132px; top: 134px; text-align: center; font-family: 'Dela Gothic One', 'Arial Black', sans-serif; font-size: 120px; line-height: 1; color: #FFF4DE\" role=\"img\" aria-label=\"Party 2 side\">2</div>\n</div>",
"leader": "<div style=\"position: relative; width: 264px; height: 408px; border-radius: 16px; overflow: hidden; background: #F6B92B; box-shadow: 0 6px 18px rgba(27,27,47,.18)\">\n<div style=\"position: absolute; inset: 10px; border: 2.5px solid #1B1B2F; border-radius: 10px\"></div>\n<svg width=\"210\" height=\"210\" viewBox=\"0 0 200 200\" style=\"position: absolute; left: 27px; top: 50px\" role=\"img\" aria-label=\"A town leader's megaphone\">\n<path d=\"M34 82 V118 H64 L136 160 V40 L64 82Z\" fill=\"#FFF4DE\" stroke=\"#1B1B2F\" stroke-width=\"5\" stroke-linejoin=\"round\"></path>\n<path d=\"M152 80 Q166 100 152 120 M166 66 Q190 100 166 134\" stroke=\"#E8553A\" stroke-width=\"7\" fill=\"none\" stroke-linecap=\"round\"></path>\n<path d=\"M66 118 L76 160 H94 L88 126\" fill=\"#E8553A\" stroke=\"#1B1B2F\" stroke-width=\"5\" stroke-linejoin=\"round\"></path>\n</svg>\n<div style=\"position: absolute; left: 0; right: 0; bottom: 74px; text-align: center; font-family: 'Dela Gothic One', 'Arial Black', sans-serif; font-size: 21px; line-height: 1.2; color: #1B1B2F\">TOWN LEADER</div>\n<div style=\"position: absolute; left: 24px; right: 24px; bottom: 42px; text-align: center; font-size: 13px; font-weight: 800; line-height: 1.3; color: #1B1B2F\">Splits the town in two</div>\n</div>",
"leader-back": "<div style=\"position: relative; width: 264px; height: 408px; border-radius: 16px; overflow: hidden; background: #FFF4DE; box-shadow: 0 6px 18px rgba(27,27,47,.18); border: 1px solid #E6D8BC; box-sizing: border-box\">\n<div style=\"position: absolute; inset: 10px; border: 2.5px solid #1B1B2F; border-radius: 10px\"></div>\n<div style=\"position: absolute; inset: 22px 22px 20px 22px; display: flex; flex-direction: column; gap: 8px\">\n<div style=\"font-family: 'Dela Gothic One', 'Arial Black', sans-serif; font-size: 20px; color: #1B1B2F\">EACH ROUND</div>\n<div style=\"display: flex; gap: 8px; font-size: 14px; line-height: 1.35\"><b style=\"color: #E8553A\">1</b><span>Cut the town in half with the split cards, not the same way as last round.</span></div>\n<div style=\"display: flex; gap: 8px; font-size: 14px; line-height: 1.35\"><b style=\"color: #E8553A\">2</b><span>Everyone else holds up 1 or 2 fingers. You break ties.</span></div>\n<div style=\"display: flex; gap: 8px; font-size: 14px; line-height: 1.35\"><b style=\"color: #E8553A\">3</b><span>That party secretly plays Transmit or Jam.</span></div>\n<div style=\"display: flex; gap: 8px; font-size: 14px; line-height: 1.35\"><b style=\"color: #E8553A\">4</b><span>Majority scores. Tie: flip the top deck card; its team scores.</span></div>\n<div style=\"display: flex; gap: 8px; font-size: 14px; line-height: 1.35\"><b style=\"color: #E8553A\">5</b><span>The Lookout abducts one searcher.</span></div>\n<div style=\"display: flex; gap: 8px; font-size: 14px; line-height: 1.35\"><b style=\"color: #E8553A\">6</b><span>Pass this card and the Lookout clockwise.</span></div>\n</div>\n</div>",
